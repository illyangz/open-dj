{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDJ",
  "version": "0.3.11",
  "identifier": "org.opendj.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenDJ",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5OTY1QTYzOUFBRTQzQzUKUldURlE2NmFZMXFXU1crRTMvS0lUK2NFT2R0eDJtWTZPWnBETi9PdkJJU0gyVmVmUXBwSU1ZdEgK",
      "endpoints": [
        "https://github.com/illyangz/open-dj/releases/latest/download/latest.json"
      ]
    }
  }
}
